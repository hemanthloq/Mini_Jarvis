# ── JARVIS API keys ─────────────────────────────────────────────
# Copy this file to `.env` (same folder) and fill in your keys.

# ── Smart-path brains ───────────────────────────────────────────
# The smart path tries these IN ORDER (Gemini -> Groq) and switches to the next
# the instant one is rate-limited or errors. Set both for best reliability; either
# alone works. At least ONE is required.

# Google Gemini — https://aistudio.google.com/apikey  (recommended primary;
# free tier, multimodal, fast). Defaults to gemini-flash-lite (fast + generous
# quota); set GEMINI_MODEL_DEEP=gemini-flash-latest for more depth over speed.
GOOGLE_API_KEY=

# Groq — https://console.groq.com/keys  (fast fallback; free tier)
GROQ_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
# (optional: only needed if you switch the smart path back to Claude)
ANTHROPIC_API_KEY=

# Deepgram — https://console.deepgram.com  (streaming STT, Nova model)
DEEPGRAM_API_KEY=

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice to use. Default is "Daniel" (calm, precise British male — good Jarvis fit).
# Browse voices at https://elevenlabs.io/app/voice-library and paste any voice ID.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# Spotify — create an app at https://developer.spotify.com/dashboard
# Set the app's Redirect URI to exactly: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ── Tuning (defaults are fine) ──────────────────────────────────
# Wake word acoustic-match score 0..1 (higher = fewer false triggers).
WAKE_THRESHOLD=0.55
# Minimum Silero VAD speech-probability (0..1) for a wake — rejects non-speech
# (grunts, coughs). Wired in backend/audio/wake.py. Run scripts/calibrate_wake.py
# to tune both to your mic.
WAKE_VAD_THRESHOLD=0.02
# Groq models for the smart path (fast default, deep for complex queries)
SMART_MODEL_FAST=openai/gpt-oss-20b
SMART_MODEL_DEEP=openai/gpt-oss-120b
# Seconds JARVIS keeps listening for a follow-up after replying (no wake word needed)
FOLLOWUP_WINDOW=7
# Push-to-talk: starts listening instantly, bypassing the wake word (good in games)
PTT_HOTKEY=ctrl+alt+j
# Mic mute (privacy): kills the wake word AND the mic button until toggled back
MUTE_HOTKEY=ctrl+alt+m
# Barge-in sensitivity: how loud you must be to interrupt JARVIS mid-sentence.
# Raise it if it interrupts itself; lower it if it ignores you.
# Run scripts\calibrate_barge.py to measure the right value for your mic.
# This is the SOURCE OF TRUTH for the barge floor; backend/config.py only holds
# a matching fallback. Room noise can lift it at runtime, but only within
# NOISE_CEILING (see backend/audio/wake.py) so calibration always still applies.
BARGE_FLOOR=0.01
# Volume (0-100) forced when a film/video/track is opened, so playback starts audible
MEDIA_VOLUME=60
# Backend host/port (HUD connects here)
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
